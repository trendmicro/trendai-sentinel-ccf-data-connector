    detail_objectLaunchTime_d = iff(isnotnull(toreal(column_ifexists("detail_objectLaunchTime_d", real(null)))), toreal(column_ifexists("detail_objectLaunchTime_d", real(null))), toreal(_d.objectLaunchTime)),
    detail_objectName_s = iff(isnotempty(tostring(column_ifexists("detail_objectName_s", ""))), tostring(column_ifexists("detail_objectName_s", "")), tostring(_d.objectName)),
    detail_objectRunAsLocalAccount_b = iff(isnotnull(tobool(column_ifexists("detail_objectRunAsLocalAccount_b", bool(null)))), tobool(column_ifexists("detail_objectRunAsLocalAccount_b", bool(null))), tobool(_d.objectRunAsLocalAccount)),
    detail_objectSigner_s = iff(isnotempty(tostring(column_ifexists("detail_objectSigner_s", ""))), tostring(column_ifexists("detail_objectSigner_s", "")), tostring(_d.objectSigner)),
