// ════════════════════════════════════════════════════════════════════════════════
// TrendMicro OAT - UNIVERSAL Parser: Works with OLD and NEW data
// ════════════════════════════════════════════════════════════════════════════════
//
// PURPOSE:
//   Universal parser for TrendMicro_XDR_OAT_CL
// ── Resolve the detail payload once: prefer a dynamic `detail` column (legacy newSchema),
//    otherwise parse the `RawData` JSON string the connector preserves (old + new flat data).
| extend _detailDyn = column_ifexists("detail", dynamic(null))
| extend _detailStr = tostring(column_ifexists("detail_s", ""))
| extend _rawData    = tostring(column_ifexists("RawData", ""))
| extend _d = case(isnotnull(_detailDyn), _detailDyn, isnotempty(_detailStr), todynamic(_detailStr), isnotempty(_rawData), todynamic(_rawData), dynamic(null))
// ── Resolve endpoint + filters objects for fallback (legacy data may carry them whole).
| extend _ep = column_ifexists("endpoint", dynamic(null))
| extend _filters = iff(isnotnull(column_ifexists("filters", dynamic(null))), column_ifexists("filters", dynamic(null)), todynamic(tostring(column_ifexists("filters_s", ""))))
| project
    TimeGenerated = todatetime(column_ifexists("TimeGenerated", datetime(null))),
    SourceSystem = tostring(column_ifexists("SourceSystem", "")),
    Computer = tostring(column_ifexists("Computer", "")),
    RawData = _rawData,
    detectionTime_t = todatetime(column_ifexists("detectionTime_t", datetime(null))),
    entityType_s = tostring(column_ifexists("entityType_s", "")),
    entityName_s = tostring(column_ifexists("entityName_s", "")),
    filters_s = tostring(column_ifexists("filters_s", "")),
    endpoint_ips_s = iff(isnotempty(tostring(column_ifexists("endpoint_ips_s", ""))), tostring(column_ifexists("endpoint_ips_s", "")), tostring(_ep.ips)),
    endpoint_name_s = iff(isnotempty(tostring(column_ifexists("endpoint_name_s", ""))), tostring(column_ifexists("endpoint_name_s", "")), tostring(_ep.endpointName)),
    endpoint_guid_g = iff(isnotempty(tostring(column_ifexists("endpoint_guid_g", ""))), tostring(column_ifexists("endpoint_guid_g", "")), tostring(_ep.agentGuid)),
    xdrCustomerId_g = tostring(column_ifexists("xdrCustomerId_g", "")),
    detail_endpointGuid_g = iff(isnotempty(tostring(column_ifexists("detail_endpointGuid_g", ""))), tostring(column_ifexists("detail_endpointGuid_g", "")), tostring(_d.endpointGuid)),
    detail_eventId_s = iff(isnotempty(tostring(column_ifexists("detail_eventId_s", ""))), tostring(column_ifexists("detail_eventId_s", "")), tostring(_d.eventId)),
    detail_eventSubId_s = iff(isnotempty(tostring(column_ifexists("detail_eventSubId_s", ""))), tostring(column_ifexists("detail_eventSubId_s", "")), tostring(_d.eventSubId)),
    detail_firstSeen_t = iff(isnotnull(todatetime(column_ifexists("detail_firstSeen_t", datetime(null)))), todatetime(column_ifexists("detail_firstSeen_t", datetime(null))), todatetime(datetime(1970-01-01) + tolong(_d.firstSeen) * 1ms)),
    detail_lastSeen_t = iff(isnotnull(todatetime(column_ifexists("detail_lastSeen_t", datetime(null)))), todatetime(column_ifexists("detail_lastSeen_t", datetime(null))), todatetime(datetime(1970-01-01) + tolong(_d.lastSeen) * 1ms)),
    detail_logonUser_s = iff(isnotempty(tostring(column_ifexists("detail_logonUser_s", ""))), tostring(column_ifexists("detail_logonUser_s", "")), tostring(_d.logonUser)),
    detail_objectCmd_s = iff(isnotempty(tostring(column_ifexists("detail_objectCmd_s", ""))), tostring(column_ifexists("detail_objectCmd_s", "")), tostring(_d.objectCmd)),
    detail_objectFileCreation_d = iff(isnotnull(toreal(column_ifexists("detail_objectFileCreation_d", real(null)))), toreal(column_ifexists("detail_objectFileCreation_d", real(null))), toreal(_d.objectFileCreation)),
    detail_objectFileHashSha256_s = iff(isnotempty(tostring(column_ifexists("detail_objectFileHashSha256_s", ""))), tostring(column_ifexists("detail_objectFileHashSha256_s", "")), tostring(_d.objectFileHashSha256)),
    detail_objectFileModifiedTime_d = iff(isnotnull(toreal(column_ifexists("detail_objectFileModifiedTime_d", real(null)))), toreal(column_ifexists("detail_objectFileModifiedTime_d", real(null))), toreal(_d.objectFileModifiedTime)),
