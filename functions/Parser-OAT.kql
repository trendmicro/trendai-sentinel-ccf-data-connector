    detail_processCmd_s = iff(isnotempty(tostring(column_ifexists("detail_processCmd_s", ""))), tostring(column_ifexists("detail_processCmd_s", "")), tostring(_d.processCmd)),
    detail_processFileCreation_d = iff(isnotnull(toreal(column_ifexists("detail_processFileCreation_d", real(null)))), toreal(column_ifexists("detail_processFileCreation_d", real(null))), toreal(_d.processFileCreation)),
    detail_processFileHashSha1_s = iff(isnotempty(tostring(column_ifexists("detail_processFileHashSha1_s", ""))), tostring(column_ifexists("detail_processFileHashSha1_s", "")), tostring(_d.processFileHashSha1)),
