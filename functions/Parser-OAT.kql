// ════════════════════════════════════════════════════════════════════════════════
// TrendMicro OAT - UNIVERSAL Parser: Works with OLD and NEW data
// ════════════════════════════════════════════════════════════════════════════════
//
// PURPOSE:
//   Universal parser that combines:
//   - OLD data: TrendMicro_XDR_OAT_CL (legacy Azure Function connector) - AS-IS
//   - NEW data: TrendMicro_XDR_OAT_CCF_CL (CCF connector) - transformed to match legacy format
//
// DEPLOYMENT:
//   Create function named: TrendMicroOAT_Complete
//
// USAGE:
//   TrendMicroOAT_Complete()
//   | where detail_filterRiskLevel_s == "high"
//   | project TimeGenerated, detail_endpointHostName_s, detail_objectCmd_s, detail_filterRiskLevel_s
//
// ════════════════════════════════════════════════════════════════════════════════

union isfuzzy=true
    // ═══════════════════════════════════════════════════════════════════════════
    // LEGACY DATA (Azure Function): Use AS-IS (already in correct format)
    // ═══════════════════════════════════════════════════════════════════════════
    (TrendMicro_XDR_OAT_CL),
    // ═══════════════════════════════════════════════════════════════════════════
    // V2 DATA (CCF Connector): Transform to match legacy format
    // ═══════════════════════════════════════════════════════════════════════════
    (TrendMicro_XDR_OAT_CCF_CL
     // CCF data already has most columns in correct format, just need to add missing legacy columns
     | extend
         // Add missing columns that exist in legacy but not in CCF (set to empty/default values)
         TenantId = coalesce(TenantId, ""),
         MG = coalesce(MG, ""),
         ManagementGroupName = coalesce(ManagementGroupName, ""),
         // Handle columns that might be missing in CCF
         detail_eventSourceType_s = coalesce(detail_eventSourceType_s, ""),
         detail_eventTime_d = coalesce(detail_eventTime_d, 0.0),
         detail_dpt_d = coalesce(detail_dpt_d, 0.0),
         detail_dst_s = coalesce(detail_dst_s, ""),
         detail_proto_s = coalesce(detail_proto_s, ""),
         detail_spt_d = coalesce(detail_spt_d, 0.0),
         detail_src_s = coalesce(detail_src_s, "")
     // Project all columns in the legacy format order
     | project
         TenantId,
         SourceSystem,
         MG,
         ManagementGroupName,
         TimeGenerated,
         Computer,
         RawData,
         detail_endpointGuid_g,
         detail_endpointHostName_s,
         detail_endpointIp_s,
         detail_endpointMacAddress_s,
         detail_eventId_s,
         detail_eventSourceType_s,
         detail_eventSubId_s,
         detail_eventTime_d,
         detail_filterRiskLevel_s,
         detail_firstSeen_t,
         detail_lastSeen_t,
         detail_logonUser_s,
         detail_objectCmd_s,
         detail_objectFileCreation_d,
         detail_objectFileHashSha1_s,
         detail_objectFileHashSha256_s,
         detail_objectFileModifiedTime_d,
         detail_objectFilePath_s,
         detail_objectFileSize_d,
         detail_objectLaunchTime_d,
         detail_objectName_s,
         detail_objectRunAsLocalAccount_b,
         detail_objectSigner_s,
         detail_objectSignerValid_s,
         detail_objectTrueType_d,
         detail_objectUser_s,
         detail_objectUserDomain_s,
         detail_osName_s,
         detail_osType_s,
         detail_osVer_s,
         detail_parentCmd_s,
         detail_parentFileCreation_d,
         detail_parentFileHashSha1_s,
         detail_parentFileHashSha256_s,
         detail_parentFileModifiedTime_d,
         detail_parentFilePath_s,
         detail_parentFileSize_d,
         detail_parentLaunchTime_d,
         detail_parentName_s,
         detail_parentTrueType_d,
         detail_parentUser_s,
         detail_parentUserDomain_s,
         detail_plang_d,
         detail_pname_s,
         detail_processCmd_s,
         detail_processFileCreation_d,
         detail_processFileHashSha1_s,
         detail_processFileHashSha256_s,
         detail_processFileModifiedTime_d,
         detail_processFilePath_s,
         detail_processFileSize_d,
         detail_processLaunchTime_d,
         detail_processName_s,
         detail_processPid_d,
         detail_processSigner_s,
         detail_processSignerValid_s,
         detail_processTrueType_d,
         detail_processUser_s,
         detail_processUserDomain_s,
         detail_tags_s,
         detail_timezone_s,
         detail_userDomain_s,
         detail_uuid_g,
         detectionTime_t,
         endpoint_guid_g,
         endpoint_ips_s,
         endpoint_name_s,
         entityName_s,
         entityType_s,
         filters_s,
         xdrCustomerId_g,
         detail_objectAppName_s,
         detail_objectContentName_s,
         detail_objectFirstSeen_d,
         detail_objectLastSeen_d,
         detail_objectRawDataStr_s,
         detail_parentSigner_s,
         detail_parentSignerValid_s,
         detail_objectSubTrueType_d,
         detail_hostName_s,
         detail_objectIps_s,
         detail_dpt_d,
         detail_dst_s,
         detail_proto_s,
         detail_spt_d,
         detail_src_s,
         detail_srcFirstSeen_d,
         detail_srcLastSeen_d,
         // Additional CCF columns (not in legacy, but included for completeness)
         detail_actResult_s,
         detail_channel_s,
         detail_domainName_s,
         detail_eventSubName_s,
         detail_firstAct_s,
         detail_firstActResult_s,
         detail_mDevice_s,
         detail_malDst_s,
         detail_malName_s,
         detail_malSubType_s,
         detail_objectFileName_s,
         detail_objectType_s,
         detail_scanType_s,
         detail_secondAct_s,
         detail_secondActResult_s,
         detail_act_s,
         detail_aggregatedCount_d,
         detail_app_s,
         detail_appGroup_s,
         detail_aptRelated_s,
         detail_clientFlag_s,
         detail_detectionType_s,
         detail_deviceDirection_s,
         detail_deviceGUID_g,
         detail_deviceMacAddress_s,
         detail_dhost_s,
         detail_dmac_s,
         detail_dstGroup_s,
         detail_dstZone_s,
         detail_dvchost_s,
         detail_eventId_d,
         detail_eventName_s,
         detail_fileExt_s,
         detail_fileHash_s,
         detail_fileName_s,
         detail_filePath_s,
         detail_filePathName_s,
         detail_fileSize_d,
         detail_fullPath_s,
         detail_hostSeverity_d,
         detail_interestedGroup_s,
         detail_interestedHost_s,
         detail_interestedIp_s,
         detail_malType_s,
         detail_malTypeGroup_s,
         detail_pAttackPhase_s,
         detail_pComp_s,
         detail_peerGroup_s,
         detail_peerHost_s,
         detail_peerIp_s,
         detail_remarks_s,
         detail_rt_t,
         detail_rtHour_d,
         detail_ruleId_d,
         detail_ruleName_s,
         detail_senderIp_s,
         detail_severity_d,
         detail_shost_s,
         detail_smac_s,
         detail_srcGroup_s,
         detail_srcZone_s,
         detail_threatType_s,
         detail_cat_d,
         detail_endpointGUID_g,
         detail_endpointHostName_s,
         detail_endpointIp_s,
         Type,
         _ResourceId
    )
